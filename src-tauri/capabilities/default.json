{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"dialog:default",
		"dialog:allow-open",
		"clipboard-manager:allow-write-text",
		{
			"identifier": "fs:allow-exists",
			"allow": [
				{
					"path": "**"
				}
			]
		}
	]
}
