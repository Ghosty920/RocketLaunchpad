{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Rocket Launchpad",
	"version": "1.0.2",
	"identifier": "RocketLaunchpad",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Rocket Launchpad",
				"backgroundColor": "#090909",
				"width": 1100,
				"height": 600,
				"devtools": true,
				"resizable": true,
				"center": true,
				"theme": "Dark"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.ico"],
		"publisher": "Ghosty.im",
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"template": "installer/installer.nsi"
			},
			"wix": {
				"template": "installer/main.wxs"
			}
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		}
	}
}
