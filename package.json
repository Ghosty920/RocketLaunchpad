{
	"name": "rocket-launchpad",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:write": "eslint src --fix",
		"clean": "cd src-tauri && cargo clean",
		"knip": "knip",
		"prepack": "husky",
		"validate": "pnpm typecheck && pnpm lint && pnpm knip"
	},
	"lint-staged": {
		"src/**/*.{js,ts,jsx,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"**/*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"base-64": "^1.0.0",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-toastify": "^11.1.0",
		"tailwindcss": "^4.3.3",
		"utf8": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/base-64": "^1.0.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/utf8": "^3.0.3",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.0",
		"globals": "^17.8.0",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0"
	},
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
