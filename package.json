{
	"name": "rocket-launchpad",
	"private": true,
	"version": "1.1.2",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:write": "eslint src --fix",
		"lint-staged": "lint-staged",
		"clean": "cd src-tauri && cargo clean",
		"knip": "knip",
		"prepare": "husky",
		"validate": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm knip"
	},
	"lint-staged": {
		"src/**/*.{js,ts,jsx,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"**/*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"base-64": "^1.0.0",
		"lucide-react": "^1.70.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-toastify": "^11.2.0",
		"tailwindcss": "^4.3.5",
		"utf8": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2.12.4",
		"@types/base-64": "^1.0.2",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/utf8": "^3.0.3",
		"@vitejs/plugin-react": "^6.2.1",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"knip": "^6.44.2",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6"
	},
	"packageManager": "pnpm@12.18.0"
}
