{
	"name": "rocket-launchpad",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:write": "eslint src --fix",
		"clean": "cd src-tauri && cargo clean",
		"knip": "knip",
		"prepack": "husky",
		"validate": "pnpm typecheck && pnpm lint && pnpm knip"
	},
	"lint-staged": {
		"src/**/*.{js,ts,jsx,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"**/*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"base-64": "^1.0.0",
		"lucide-react": "^1.25.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"utf8": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/base-64": "^1.0.2",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/utf8": "^3.0.3",
		"@vitejs/plugin-react": "^4.7.0",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"knip": "^6.27.0",
		"lint-staged": "^17.1.1",
		"prettier": "^3.9.6",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.6"
	},
	"packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
