{
	"name": "rocket-launchpad",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"lint:write": "eslint src --fix",
		"clean": "cd src-tauri && cargo clean",
		"knip": "knip",
		"prepack": "husky",
		"validate": "pnpm typecheck && pnpm lint && pnpm knip"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2.7.0",
		"@tauri-apps/plugin-fs": "^2.5.0",
		"@tauri-apps/plugin-opener": "^2.5.3",
		"base-64": "^1.0.0",
		"lucide-react": "^1.14.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"tailwindcss": "^4.2.4",
		"utf8": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2.11.0",
		"@types/base-64": "^1.0.2",
		"@types/node": "^22.19.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/utf8": "^3.0.3",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^10.3.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"knip": "^6.11.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^7.3.2"
	}
}
